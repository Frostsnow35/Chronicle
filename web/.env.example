# Supabase 项目设置：从 Supabase Dashboard → Project Settings → API 复制。
# 新版面板变量名（推荐，与 Dashboard 一致，直接粘贴即可）：
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL 本项目不需要，忽略即可。

# 兼容旧版变量名（二选一即可，无需重复填写）：
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# 站点公网域名（用于配对链接、OAuth 回调、分享链接），例如 https://my-notes.vercel.app
NEXT_PUBLIC_SITE_URL=
